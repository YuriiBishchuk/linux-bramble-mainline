/dts-v1/;

#include "sm7250.dtsi"

/ {
	model = "Google Inc. MSM sm7250 v2 Bramble PVT";
	compatible = "google,bramble-sm7250", "google,bramble", "qcom,sm7250";
	qcom,msm-id = <400 0x20000>, <440 0x20000>;
	qcom,board-id = <0x0a1e05 0>;

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer: framebuffer@a0000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xa0000000 0x0 0x2300000>;
			width = <1080>;
			height = <2340>;
			stride = <4320>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	/*
	 * Match the live Android memory map exactly.  The 0xbcc00000-0xc0000000
	 * range is not RAM, and the upper 4 GiB is a separate bank.  A single
	 * contiguous 6 GiB node makes Linux touch the hole and panic before
	 * userspace.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x3cc00000>;
	};

	memory@c0000000 {
		device_type = "memory";
		reg = <0x0 0xc0000000 0x0 0x40000000>;
	};

	memory@100000000 {
		device_type = "memory";
		reg = <0x1 0x00000000 0x1 0x00000000>;
	};

	reg_vdda_pll: regulator-vdda-pll {
		compatible = "regulator-fixed";
		regulator-name = "vdda_pll";
		regulator-always-on;
	};

	reg_vdda33: regulator-vdda33 {
		compatible = "regulator-fixed";
		regulator-name = "vdda33";
		regulator-always-on;
	};

	reg_vdda18: regulator-vdda18 {
		compatible = "regulator-fixed";
		regulator-name = "vdda18";
		regulator-always-on;
	};
};

&soc {

	qupv3_se0_2uart: serial@894000 {
		compatible = "qcom,geni-uart";
		reg = <0x0 0x00894000 0x0 0x4000>;
		interrupts = <GIC_SPI 583 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";

		bluetooth {
			compatible = "qcom,wcn3990-bt";
			max-speed = <3200000>;
		};
	};
};

&tlmm {
	gpio-reserved-ranges = <0 4>;


};

&usb_1_hsphy {
	vdda-pll-supply = <&reg_vdda_pll>;
	vdda33-supply = <&reg_vdda33>;
	vdda18-supply = <&reg_vdda18>;
	status = "okay";
};

&usb_1_qmpphy {
	vdda-phy-supply = <&reg_vdda18>;
	vdda-pll-supply = <&reg_vdda_pll>;
	status = "disabled";
};

&usb_1 {
	status = "okay";
};

&ufs_mem_phy {
	status = "okay";
};

&ufs_mem_hc {
	status = "okay";
};
